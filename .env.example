# === Aethra configuration (copy to .env or export in your shell) ===

# Local LLM API (OpenAI-compatible /v1/chat/completions endpoint)
# Ollama:      http://localhost:11434/v1        (model e.g. qwen2.5:7b)
# LM Studio:   http://localhost:1234/v1
# llama.cpp:   http://localhost:8080/v1
AETHRA_LLM_BASE_URL=http://localhost:11434/v1
AETHRA_LLM_MODEL=qwen2.5:7b
AETHRA_LLM_API_KEY=not-needed
AETHRA_LLM_TEMPERATURE=0.4
AETHRA_LLM_MAX_TOKENS=1024
AETHRA_LLM_TIMEOUT=120

# Embeddings: auto | st | tfidf
#   auto  -> use sentence-transformers if installed, else hashed TF-IDF fallback
#   st    -> force sentence-transformers (requires: pip install sentence-transformers)
#   tfidf -> force the dependency-free hashed TF-IDF embedder
AETHRA_EMBEDDING_BACKEND=auto
AETHRA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval
AETHRA_TOP_K=5
AETHRA_CHUNK_SIZE=900
AETHRA_CHUNK_OVERLAP=150

# Memory
AETHRA_RECENT_WINDOW=12
AETHRA_SUMMARIZE_THRESHOLD=24

# OCR
AETHRA_OCR_LANG=eng

# Storage / logging
AETHRA_DATA_DIR=./data
AETHRA_LOG_LEVEL=INFO
